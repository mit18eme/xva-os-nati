<script>
/* =========================================
   MÚSICA
   Comienza en el segundo 13 al abrir el sobre.
   El archivo debe llamarse music.mp3 y estar
   junto a index.html.
========================================= */

const MUSIC_START_SECONDS = 13;

const envelope = document.getElementById("envelope");
const envelopeScreen = document.getElementById("envelopeScreen");
const music = document.getElementById("backgroundMusic");
const musicToggle = document.getElementById("musicToggle");

let invitationOpened = false;
let musicStartedOnce = false;

function updateMusicButton() {
  const playing = !music.paused;
  musicToggle.textContent = playing ? "♫" : "♪";
  musicToggle.setAttribute(
    "aria-label",
    playing ? "Pausar música" : "Reanudar música"
  );
  musicToggle.setAttribute("aria-pressed", String(playing));
}

async function startMusic() {
  try {
    if (!musicStartedOnce) {
      music.currentTime = MUSIC_START_SECONDS;
    } else if (music.ended) {
      music.currentTime = MUSIC_START_SECONDS;
    }

    await music.play();
    musicStartedOnce = true;
    updateMusicButton();
  } catch (error) {
    updateMusicButton();
    console.warn(
      "No se pudo reproducir la música. Comprueba que music.mp3 esté junto a index.html.",
      error
    );
  }
}

envelope.addEventListener("click", async () => {
  if (invitationOpened) return;

  invitationOpened = true;
  envelope.classList.add("open");

  // La música intenta iniciar después del toque del invitado.
  await startMusic();

  setTimeout(() => {
    envelopeScreen.classList.add("opened");
  }, 450);
});

musicToggle.addEventListener("click", async () => {
  if (music.paused) {
    // Al reanudar, continúa desde el punto donde se pausó.
    await startMusic();
  } else {
    music.pause();
    updateMusicButton();
  }
});

music.addEventListener("play", updateMusicButton);
music.addEventListener("pause", updateMusicButton);

/* Detiene el audio cuando el visitante sale de la página. */
window.addEventListener("pagehide", () => {
  music.pause();
});

/* =========================================
   CUENTA REGRESIVA
   Fecha de la misa: 7 de noviembre de 2026,
   a las 7:00 p. m., hora de Veracruz.
========================================= */

const eventDate = new Date("2026-11-07T19:00:00-06:00").getTime();

function updateCountdown() {
  const difference = eventDate - Date.now();

  const days = document.getElementById("days");
  const hours = document.getElementById("hours");
  const minutes = document.getElementById("minutes");
  const seconds = document.getElementById("seconds");

  if (difference <= 0) {
    days.textContent = "0";
    hours.textContent = "0";
    minutes.textContent = "0";
    seconds.textContent = "0";
    return;
  }

  days.textContent = Math.floor(difference / 86400000);
  hours.textContent = Math.floor((difference % 86400000) / 3600000);
  minutes.textContent = Math.floor((difference % 3600000) / 60000);
  seconds.textContent = Math.floor((difference % 60000) / 1000);
}

updateCountdown();
setInterval(updateCountdown, 1000);

/* =========================================
   GALERÍA
   Incluye NATLI1 a NATLI40, excepto 23, 32 y 38.
========================================= */

const excludedPhotos = [23, 32, 38];

const galleryPhotos = Array.from(
  { length: 40 },
  (_, index) => index + 1
)
  .filter(number => !excludedPhotos.includes(number))
  .map(number => `images/NATLI${number}.jpg`);

let currentPhoto = 0;

const galleryImage = document.getElementById("galleryImage");
const galleryCounter = document.getElementById("galleryCounter");

function showPhoto(index) {
  currentPhoto =
    (index + galleryPhotos.length) % galleryPhotos.length;

  galleryImage.alt = `Fotografía ${currentPhoto + 1} de ${galleryPhotos.length} de Natali Gissel`;
  galleryImage.src = galleryPhotos[currentPhoto];
  galleryCounter.textContent =
    `${currentPhoto + 1} / ${galleryPhotos.length}`;
}

document.getElementById("prevPhoto").addEventListener("click", () => {
  showPhoto(currentPhoto - 1);
});

document.getElementById("nextPhoto").addEventListener("click", () => {
  showPhoto(currentPhoto + 1);
});

galleryImage.addEventListener("error", () => {
  galleryImage.alt =
    "No se encontró esta fotografía. Revisa su nombre y extensión dentro de la carpeta images.";
});

/* Deslizar la galería en pantallas táctiles. */
let touchStartX = 0;

galleryImage.addEventListener("touchstart", event => {
  touchStartX = event.changedTouches[0].screenX;
}, { passive: true });

galleryImage.addEventListener("touchend", event => {
  const touchEndX = event.changedTouches[0].screenX;
  const difference = touchEndX - touchStartX;

  if (Math.abs(difference) > 45) {
    showPhoto(currentPhoto + (difference < 0 ? 1 : -1));
  }
}, { passive: true });

showPhoto(0);

