   CONFIRMACIÓN POR WHATSAPP

   Sustituye el número de ejemplo por el número
   real, incluyendo el código de país, sin +,
   espacios ni guiones.
========================================= */

const whatsappNumber = "5210000000000";

const whatsappMessage =
  "¡Hola! Confirmo mi asistencia a los XV años de Natali Gissel Reyes Segura, el sábado 7 de noviembre de 2026.";

const whatsappButton = document.getElementById("whatsappButton");
const whatsappHelp = document.getElementById("whatsappHelp");

if (/^\d{10,15}$/.test(whatsappNumber) &&
    whatsappNumber !== "5210000000000") {
  whatsappButton.href =
    `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
  whatsappHelp.hidden = true;
} else {
  whatsappButton.addEventListener("click", event => {
    event.preventDefault();
