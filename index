<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#f8f2e8">

<title>Mis XV años | Natali Gissel</title>
<meta name="description" content="Acompáñame a celebrar mis XV años. Natali Gissel Reyes Segura.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
:root {
  --marfil: #F8F2E8;
  --champan: #E8D5B5;
  --arena: #D6C2A5;
  --taupe: #9B8570;
  --cuero: #74543B;
  --cafe: #493326;
  --blanco: #fffdf9;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 20px;
}

body {
  background: var(--marfil);
  color: var(--cafe);
  font-family: 'Montserrat', sans-serif;
  font-weight: 300;
  overflow-x: hidden;
}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
}

button {
  font: inherit;
}

section {
  padding: 80px 22px;
}

.container {
  width: min(1050px, 100%);
  margin: auto;
}

.eyebrow {
  font-size: .72rem;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: var(--cuero);
  line-height: 1.8;
}

.script {
  font-family: 'Great Vibes', cursive;
  font-weight: 400;
}

h1, h2, h3 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 500;
}

.section-title {
  font-size: clamp(2.5rem, 7vw, 4rem);
  text-align: center;
  line-height: 1.1;
  margin: 12px 0 20px;
}

.section-intro {
  max-width: 650px;
  margin: 0 auto 35px;
  text-align: center;
  line-height: 1.9;
  font-size: .9rem;
}

.ornament {
  color: var(--taupe);
  text-align: center;
  letter-spacing: .4em;
  margin: 22px 0;
}

.btn {
  display: inline-block;
  text-decoration: none;
  border: 1px solid var(--cuero);
  padding: 13px 22px;
  color: var(--cafe);
  font-size: .72rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  background: transparent;
  transition: .25s ease;
  cursor: pointer;
}

.btn:hover {
  background: var(--cuero);
  color: white;
}

.center {
  text-align: center;
}

/* PORTADA */

.hero {
  position: relative;
  min-height: 100svh;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: var(--cafe);
  color: var(--blanco);
  isolation: isolate;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(
      to bottom,
      rgba(35, 23, 15, .35),
      rgba(35, 23, 15, .65)
    ),
    url("images/NATLI32.jpg") center 35% / cover no-repeat;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 16px;
  border: 1px solid rgba(248, 242, 232, .75);
  pointer-events: none;
  z-index: -1;
}

.hero-content {
  width: min(760px, 100%);
  padding: 70px 26px 45px;
}

.hero .eyebrow {
  color: var(--champan);
}

.hero h1 {
  font-size: clamp(2.5rem, 8vw, 5.5rem);
  line-height: .98;
  margin: 25px 0 5px;
}

.hero .name {
  font-size: clamp(3.5rem, 11vw, 7rem);
  line-height: 1.2;
  color: var(--champan);
  margin: 8px 0 18px;
}

.hero-date {
  margin-top: 25px;
  font-size: .8rem;
  letter-spacing: .18em;
  line-height: 2;
}

.hero-line {
  width: 75px;
  height: 1px;
  background: var(--champan);
  margin: 22px auto;
}

.scroll-cue {
  display: inline-block;
  margin-top: 35px;
  text-decoration: none;
  color: var(--blanco);
  font-size: .68rem;
  letter-spacing: .15em;
  text-transform: uppercase;
  animation: float 2s ease-in-out infinite;
}

.scroll-cue span {
  display: block;
  font-size: 1.6rem;
  margin-top: 5px;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(6px); }
}

/* MUSICA */

.music-control {
  position: fixed;
  z-index: 20;
  bottom: 18px;
  right: 18px;
  background: var(--cafe);
  color: var(--blanco);
  border: 1px solid var(--champan);
  border-radius: 30px;
  padding: 12px 17px;
  font-size: .7rem;
  cursor: pointer;
  box-shadow: 0 4px 18px #0002;
}

/* MENSAJE */

.message {
  background: var(--blanco);
  text-align: center;
}

.message-card {
  max-width: 800px;
  margin: auto;
  border: 1px solid var(--arena);
  padding: clamp(30px, 7vw, 65px);
  position: relative;
}

.message-card::before {
  content: "✦";
  color: var(--taupe);
  font-size: 1.4rem;
  position: absolute;
  top: 12px;
  left: 50%;
  transform: translateX(-50%);
}

.message-card p {
  line-height: 2;
  font-size: .92rem;
}

.message-card .script {
  font-size: 2.6rem;
  margin-top: 25px;
}

/* CUENTA REGRESIVA */

.countdown-section {
  text-align: center;
  background: var(--champan);
}

.countdown {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  max-width: 680px;
  margin: 35px auto 0;
}

.time-box {
  background: rgba(255, 253, 249, .7);
  padding: 20px 5px;
  border: 1px solid #fff9;
}

.time-box strong {
  display: block;
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 6vw, 3.4rem);
  font-weight: 500;
}

.time-box span {
  font-size: .62rem;
  letter-spacing: .1em;
  text-transform: uppercase;
}

/* FAMILIA */

.family {
  background: var(--marfil);
  text-align: center;
}

.family-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 35px;
}

.family-card {
  padding: 28px 18px;
  border: 1px solid var(--arena);
  background: rgba(255, 253, 249, .55);
}

.family-card h3 {
  font-size: 1.9rem;
  margin-bottom: 15px;
}

.family-card p {
  font-size: .86rem;
  line-height: 1.9;
}

.family-card .script {
  font-size: 2rem;
  margin-bottom: 8px;
}

/* EVENTOS */

.events {
  background: var(--blanco);
}

.event-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 25px;
  margin-top: 35px;
}

.event-card {
  background: var(--marfil);
  border: 1px solid var(--arena);
  text-align: center;
  overflow: hidden;
}

.event-card img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  object-position: center 35%;
}

.event-info {
  padding: 28px 22px 32px;
}

.event-info h3 {
  font-size: 2.1rem;
  margin: 10px 0;
}

.event-info p {
  font-size: .83rem;
  line-height: 1.9;
  margin-bottom: 18px;
}

.event-time {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.7rem;
  color: var(--cuero);
  margin-bottom: 10px;
}

/* ITINERARIO */

.timeline-section {
  background: var(--marfil);
}

.timeline {
  max-width: 650px;
  margin: 35px auto 0;
}

.timeline-item {
  display: grid;
  grid-template-columns: 115px 1fr;
  gap: 20px;
  padding: 18px 0;
  border-bottom: 1px solid var(--arena);
  align-items: center;
}

.timeline-time {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.25rem;
  color: var(--cuero);
}

.timeline-item h3 {
  font-size: 1.45rem;
  margin-bottom: 4px;
}

.timeline-item p {
  font-size: .78rem;
  line-height: 1.7;
}

/* VESTIMENTA */

.attire {
  background: var(--cafe);
  color: var(--blanco);
  text-align: center;
}

.attire .eyebrow {
  color: var(--champan);
}

.attire-card {
  max-width: 700px;
  margin: 30px auto 0;
  border: 1px solid var(--champan);
  padding: clamp(28px, 7vw, 55px);
}

.attire-card h3 {
  font-size: 2.4rem;
  margin: 12px 0;
}

.attire-card p {
  font-size: .86rem;
  line-height: 2;
}

.color-swatches {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin: 25px 0;
}

.swatch {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  border: 1px solid #ffffff70;
}

.attire-note {
  color: var(--champan);
  font-size: .75rem !important;
}

/* GALERIA */

.gallery-section {
  background: var(--blanco);
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin-top: 35px;
}

.gallery img {
  width: 100%;
  aspect-ratio: 3 / 4;
  object-fit: cover;
  cursor: pointer;
  transition: transform .25s ease;
  background: var(--champan);
}

.gallery img:hover {
  transform: scale(1.02);
}

.gallery img.broken {
  display: none;
}

/* CONFIRMACION */

.rsvp {
  background: var(--champan);
  text-align: center;
}

.rsvp-card {
  max-width: 700px;
  margin: auto;
  background: var(--blanco);
  padding: clamp(30px, 7vw, 60px);
  border: 1px solid white;
}

.rsvp-card p {
  font-size: .88rem;
  line-height: 1.9;
  margin-bottom: 25px;
}

/* CIERRE */

.closing {
  background: var(--cafe);
  color: var(--blanco);
  text-align: center;
  padding: 90px 22px;
}

.closing .eyebrow {
  color: var(--champan);
}

.closing .script {
  color: var(--champan);
  font-size: clamp(3rem, 10vw, 5.5rem);
  margin: 22px 0;
}

.closing p {
  max-width: 650px;
  margin: 0 auto;
  font-size: .86rem;
  line-height: 2;
}

footer {
  background: var(--cafe);
  color: var(--champan);
  text-align: center;
  padding: 18px;
  font-size: .65rem;
  letter-spacing: .1em;
}

/* VISOR DE FOTOGRAFIAS */

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(25, 17, 12, .94);
  align-items: center;
  justify-content: center;
  padding: 25px;
}

.lightbox.active {
  display: flex;
}

.lightbox img {
  max-width: 95%;
  max-height: 85vh;
  object-fit: contain;
}

.lightbox button {
  position: absolute;
  top: 18px;
  right: 20px;
  background: transparent;
  color: white;
  border: 0;
  font-size: 2.5rem;
  cursor: pointer;
}

@media (max-width: 650px) {
  section {
    padding: 65px 18px;
  }

  .hero::after {
    inset: 10px;
  }

  .countdown {
    gap: 7px;
  }

  .time-box {
    padding: 15px 3px;
  }

  .time-box span {
    font-size: .53rem;
    letter-spacing: .04em;
  }

  .family-grid,
  .event-grid {
    grid-template-columns: 1fr;
  }

  .event-card img {
    height: 330px;
  }

  .gallery {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .timeline-item {
    grid-template-columns: 95px 1fr;
    gap: 12px;
  }

  .timeline-time {
    font-size: 1.1rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
}
</style>
</head>

<body>

<!-- PORTADA: SIN SOBRE NI PANTALLA DE ENTRADA -->

<header class="hero" id="inicio">
