}

img {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

section {
  padding: 75px 20px;
  text-align: center;
}

h1, h2, h3 {
  font-weight: normal;
  line-height: 1.25;
}

h2 {
  font-size: clamp(2rem, 5vw, 3.2rem);
  margin-bottom: 18px;
}

h3 {
  font-size: 1.35rem;
}

p {
  margin: 10px 0;
}

.eyebrow {
  color: var(--cuero);
  letter-spacing: 3px;
  text-transform: uppercase;
  font-size: .75rem;
  margin-bottom: 18px;
}

.script {
  font-style: italic;
  color: var(--cuero);
}

.ornament {
  color: var(--taupe);
  letter-spacing: 8px;
  margin: 20px 0;
}

.btn {
  display: inline-block;
  background: var(--cuero);
  color: var(--marfil);
  border: 1px solid var(--cuero);
  padding: 12px 24px;
  margin: 12px 5px;
  transition: background .25s, color .25s;
  cursor: pointer;
}

.btn:hover {
  background: var(--cafe);
}

.btn-outline {
  color: var(--marfil);
  background: transparent;
  border-color: var(--champan);
}

.btn-outline:hover {
  background: var(--champan);
  color: var(--cafe);
}

/* SOBRE DE BIENVENIDA */

.envelope-screen {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background:
    radial-gradient(ellipse at top, #ffffff 0%, transparent 65%),
    var(--marfil);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 25px;
  text-align: center;
  transition: opacity .8s, visibility .8s;
}

.envelope-screen.opened {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.envelope-screen h2 {
  margin-bottom: 0;
}

.envelope {
  position: relative;
  width: min(300px, 80vw);
  height: 190px;
  margin: 35px 0;
  background: var(--champan);
  border: 1px solid var(--taupe);
  box-shadow: 0 15px 35px #49332620;
  cursor: pointer;
  appearance: none;
}

.envelope::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--arena);
  clip-path: polygon(0 0, 100% 0, 50% 58%);
  transform-origin: top;
  transition: transform .6s;
  z-index: 2;
}

.envelope::after {
  content: "N";
  position: absolute;
  z-index: 3;
  top: 72px;
  left: calc(50% - 24px);
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--marfil);
  background: var(--cuero);
  font-size: 1.5rem;
}

.envelope.open::before {
  transform: rotateX(180deg);
}

.envelope-screen small {
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: .7rem;
}

/* PORTADA */

.hero {
  min-height: 100svh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 35px 20px;
  color: white;
  background:
    linear-gradient(#24180d66, #24180d99),
    url("images/NATLI32.jpg") center 35% / cover no-repeat;
}

.hero-content {
  width: min(650px, 100%);
  padding: 38px 20px;
  border: 1px solid #E8D5B5B0;
  background: #49332645;
  backdrop-filter: blur(2px);
  text-align: center;
}

.hero .eyebrow,
.hero .script {
  color: var(--champan);
}

.hero h1 {
  font-size: clamp(2.8rem, 11vw, 6.5rem);
  margin: 12px 0;
  overflow-wrap: anywhere;
}

.hero-subtitle {
  letter-spacing: 3px;
  text-transform: uppercase;
}

.hero-date {
